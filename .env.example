# Copy to .env.local. Leave both empty to run on the built-in sample data (demo mode).
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: 'mock' forces the sample data even when the two values above are set.
# VITE_DATA_SOURCE=mock

# Card and wallet payment through Paymob (needs the Edge Functions in
# supabase/functions; see the README there). Leave unset for cash only.
# VITE_PAYMOB_ENABLED=true
